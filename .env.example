# CareBridge frontend settings. Copy to .env.local and fill in from the
# backend stack outputs (see README.md, "Populate frontend config").
#
# Everything here is PUBLIC configuration. Vite inlines every VITE_ variable
# into the JavaScript sent to browsers. User pool IDs, app client IDs, and
# domain URLs are safe to expose. NEVER put passwords, client secrets, AWS
# access keys, or session tokens in any VITE_ variable; the app refuses to
# start if it sees a variable name that looks like one.

# Stack output ApiBaseUrl (no trailing slash needed)
VITE_API_BASE_URL=https://abc123example.execute-api.us-east-1.amazonaws.com/dev

# Stack output Region
VITE_COGNITO_REGION=us-east-1

# Stack output UserPoolId
VITE_COGNITO_USER_POOL_ID=us-east-1_EXAMPLE

# Stack output UserPoolClientId (public SPA client, no secret)
VITE_COGNITO_APP_CLIENT_ID=1example23456789abcdefghij

# Stack output CognitoLoginDomain
VITE_COGNITO_DOMAIN=https://your-prefix.auth.us-east-1.amazoncognito.com

# Must exactly match the stack's CallbackUrl / SignOutUrl parameters.
# Local defaults; open the app at http://localhost:5173 (not 127.0.0.1).
VITE_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_AUTH_LOGOUT_URI=http://localhost:5173/

# Optional. The incident the nurse workspace reads. Defaults to the seeded
# demo incident INC-0042.
# VITE_INCIDENT_ID=INC-0042
