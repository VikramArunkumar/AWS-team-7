# CareBridge environment variables (copy to .env and fill in for local/deploy).
# See .kiro/specs/carebridge-mvp/design.md "Environment variables".

# --- Backend (Lambda) ---
TABLE_NAME=CareBridge
BUCKET_NAME=carebridge-policies-dev
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# Optional fallback model (stretch)
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Bedrock Knowledge Base for policy Q&A (provisioned separately; see design.md)
KB_ID=
KB_MODEL_ARN=
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Set to 1 to return canned structured JSON instead of calling Bedrock (dev only)
BEDROCK_MOCK=0

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:3000
